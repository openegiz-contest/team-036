{
  "uid": "openpit-twin",
  "title": "OpenPit Twin \u2014 Dispatch Control",
  "tags": [
    "openegiz",
    "openpit",
    "dispatch"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "description": "Open-pit fleet dispatch digital twin. Telemetry flows through MQTT -> Eclipse Ditto -> Telegraf -> InfluxDB -> Grafana.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Ore delivered (t)",
      "datasource": {
        "type": "influxdb",
        "uid": "opentwins-influxdb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "masst",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "opentwins-influxdb"
          },
          "query": "from(bucket: \"default\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r.thingId == \"org.openegiz.openpit:pit-01\" and r._field == \"value_ore_mined_properties_value\")\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ]
    },
